#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"
#include "radcache.glsl"

// Radiance cache resolve, one thread per entry: this frame's sum -> running average (capped at RC_MAX_SAMPLES,
// so moving lights fade in within a few frames), cells untouched for RC_MAX_AGE frames are freed.
layout(local_size_x = 64) in;

#define RC_MAX_SAMPLES 128.0
#define RC_MAX_AGE 60u

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= RC_SIZE) return;
    uint e = i * RC_STRIDE;
    if (rc[e] == 0u) return;
    uint n = rc[e + 8u];
    if (n == 0u) {
        uint age = rc[e + 1u] + 1u;
        if (age <= RC_MAX_AGE) { rc[e + 1u] = age; return; }
        for (uint k = 0u; k < RC_STRIDE; k++) rc[e + k] = 0u;
        return;
    }
    float m = uintBitsToFloat(rc[e + 15u]);
    float mNew = min(m + float(n), RC_MAX_SAMPLES), w = min(float(n) / mNew, 1.0);
    for (uint k = 0u; k < 6u; k++) {  // total rgb, direct rgb
        float v = mix(uintBitsToFloat(rc[e + 9u + k]), float(rc[e + 2u + k]) / (RC_SCALE * float(n)), w);
        rc[e + 9u + k] = floatBitsToUint(v);
        rc[e + 2u + k] = 0u;
    }
    rc[e + 15u] = floatBitsToUint(mNew);
    rc[e + 1u] = 0u;
    rc[e + 8u] = 0u;
}
