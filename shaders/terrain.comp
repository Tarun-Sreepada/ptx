#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// Camera-centred terrain grid. Spacing grows smoothly with distance (0.5 m near, ~800 m at the edge),
// so detail falls off continuously instead of swapping LOD rings.
layout(local_size_x = 64) in;
const uint TNV = 257u;

void main() {
    uint id = gl_GlobalInvocationID.x;
    if (id >= TNV * TNV) return;
    vec2 u = vec2(float(id % TNV), float(id / TNV)) / float(TNV - 1u) * 2.0 - 1.0;
    vec2 a = abs(u);
    vec2 xz = F.terrainP.xy + sign(u) * (F.terrainP.z * a + F.terrainP.w * a * a * a * a);
    float h = terrainHeight(xz);
    const float e = 0.15;
    vec3 n = normalize(vec3(terrainHeight(xz - vec2(e, 0)) - terrainHeight(xz + vec2(e, 0)), 2.0 * e,
                            terrainHeight(xz - vec2(0, e)) - terrainHeight(xz + vec2(0, e))));
    uint b = id * 6u;
    tv[b] = xz.x; tv[b + 1u] = h; tv[b + 2u] = xz.y;
    tv[b + 3u] = n.x; tv[b + 4u] = n.y; tv[b + 5u] = n.z;
}
