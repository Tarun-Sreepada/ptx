#version 460
#extension GL_GOOGLE_include_directive : require
#include "core/common.glsl"

// Indirect light: N paths leave the first hit (settings.x), each continues for `bounces` bounces
// with 1 ray per bounce and next-event estimation (sun + one random light) at every vertex.
// With ReSTIR GI on, the N paths become RIS candidates + temporal reuse (-> giCur);
// restir_gi_spatial.comp then does spatial reuse and shading. Otherwise this pass shades directly.
layout(local_size_x = 8, local_size_y = 8) in;

#include "lighting/path.glsl"

// Dynamic lights only (the orbs), for the additive pass over baked interiors.
vec3 dynamicNEE(vec3 x, vec3 n, uint mat, inout uint s) { return lightNEE(x, n, mat, 0u, F.bake.y, s); }

// Direction for one path through the glossy lobes (GGX specular, clearcoat, thin-walled transmission): the lobe
// picked by its share of the albedo, the direction by visible-normal sampling. wgt = BRDF * cos / pdf; nOut = the
// side the path leaves from; spread = the lobe's cone spread. False: no glossy energy toward this view.
bool glossySample(Surf sf, vec3 v, vec3 u3, out vec3 l, out vec3 nOut, out vec3 wgt, out float spread) {
    vec3 n = sf.n, Tg = sf.T, Bt = cross(n, Tg);
    float nv = max(dot(n, v), 1e-4);
    vec3 vl = vec3(dot(v, Tg), dot(v, Bt), nv);
    vec2 a = surfAlpha(sf);
    float ac = ccAlpha(sf);
    vec3 F0 = surfF0(sf);
    float ccOver = 1.0 - sf.cc * fresnel1(0.04, nv);
    vec3 specA = envBRDFApprox2(F0, sqrt(a.x * a.y), nv);
    float ks = max(specA.r, max(specA.g, specA.b));
    float wS = (sf.spec > 0.0 || sf.metal > 0.0) ? lum(specA) * ccOver : 0.0;
    float wC = sf.cc * envBRDFApprox2(vec3(0.04), ac, nv).g;
    float wT = lum(sf.base) * sf.trans * (1.0 - ks) * ccOver;
    float sum = wS + wC + wT;
    if (sum <= 1e-5) return false;
    float u = u3.x * sum;
    bool coat = u >= wS && u < wS + wC, through = u >= wS + wC;
    vec2 al = coat ? vec2(ac) : a;
    vec3 h = sampleVNDF(vl, al, u3.y, u3.z);
    vec3 ll = reflect(-vl, h);
    float vh = max(dot(vl, h), 0.0);
    if (through) {  // refraction into the glass through the sampled microfacet
        ll = refract(-vl, h, 1.0 / sf.ior);
        if (dot(ll, ll) < 1e-6 || ll.z >= 0.0) return false;
        wgt = sf.base * sf.trans * (1.0 - fresnel(F0, vh)) * ccOver / (wT / sum);
    } else {
        if (ll.z <= 0.0) return false;
        float g = ggxG2(vl, ll, al) / ggxG1(vl, al);
        wgt = coat ? vec3(sf.cc * fresnel1(0.04, vh) * g / (wC / sum)) : fresnel(F0, vh) * g * ccOver / (wS / sum);
    }
    l = normalize(Tg * ll.x + Bt * ll.y + n * ll.z);
    nOut = through ? -n : n;
    spread = sqrt(al.x * al.y);
    return true;
}

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (!inScreen(p)) return;
    uint idx = uint(p.y) * F.res.x + uint(p.x);
    vec4 P = loadPos(p);
    bool restir = (F.settings.z & FLAG_GI_RESTIR) != 0u;
    if (P.w < 0.0 || (F.settings.z & FLAG_NO_GI) != 0u) {
        imageStore(indirectImg, p, vec4(0));
        imageStore(specImg, p, vec4(0));
        if (restir) storeGICur(idx, GIRes(vec3(0), vec3(0), vec3(0), 0.0, 0.0, 0.0));
        return;
    }

    vec3 xSeen = P.xyz, x0 = xSeen - restOffset(p);  // paths start at rest, reprojection uses what was seen
    vec3 n0 = imageLoad(gNorm, p).xyz;
    uint s = seedFor(p, 3u);
    uint B = max(F.settings.y, 1u);

    // Baked interior: the probes hold sky, sun, static lights and emitters (for this building's switch state);
    // only light from dynamic lights is traced on top, one ray + one shadow ray instead of N full paths.
    vec3 baked;
    bool isBaked = bakedIndirect(x0, n0, baked);
    // Checkerboard: with ReSTIR, the skipped half gets its sample from temporal reuse and its traced neighbours
    // (spatial pass); glossy paths are view dependent and always traced.
    // Squares of F.settings.w >> 16 pixels: 8 and up skip whole 8x8 workgroups (a warp with half its lanes idle
    // costs as much as a full one), finer squares look smoother but save little time.
    uvec2 tile = gl_WorkGroupID.xy;
    // Quarter rate (bit 24): one cell of each 2 x 2 is traced per frame, the four in turn.
    uvec2 cell = uvec2(p) / max((F.settings.w >> 16u) & 0xffu, 1u);
    bool quarter = ((F.settings.w >> 24u) & 1u) != 0u;
    uint phase = quarter ? ((cell.x & 1u) + 2u * (cell.y & 1u) + F.res.z) & 3u : (cell.x + cell.y + F.res.z) & 1u;
    bool skip = restir && (F.settings.z & FLAG_GI_CHECKER) != 0u && phase != 0u;
    rcTrain = rcHash(tile.x * 73856093u ^ tile.y * 19349663u ^ F.res.z * 83492791u) % RC_TRAIN == 0u;
    uint N = isBaked || skip ? 0u : max(F.settings.x, 1u);
    vec3 gl = vec3(0), gW = vec3(0);
    float gSide = 1.0, gSpread = 0.0, gEmit = 0.0, gOcc = 1.0;
    bool glossy = false;
    {   // the surface is only needed here and after the paths: keep it out of the registers live across them
        Surf sf = loadSurf(p);
        if (surfGlossy(sf)) {
            vec3 v = -cameraRay(p), gN;
            glossy = glossySample(sf, v, vec3(bn(p, 16u), bn2(p, 17u)), gl, gN, gW, gSpread);  // blue noise
            gW /= surfAlbedo(sf, max(dot(n0, v), 1e-4));
            gSide = dot(gN, n0) < 0.0 ? -1.0 : 1.0;
            gEmit = glossyEmitWeight(sf);
            vec2 ga = surfAlpha(sf);
            if ((F.settings.z & FLAG_MICRO_SHADOW) != 0u) gOcc = specOcclusion(max(dot(n0, v), 0.0), sf.ao, sqrt(ga.x * ga.y));
        }
    }

    // N diffuse path candidates + the glossy path, through one tracePath call site (keeps the shader small)
    GIRes r = GIRes(vec3(0), vec3(0), vec3(0), 0.0, 0.0, 0.0);
    vec3 acc = vec3(0), glossyL = vec3(0);
    for (uint k = 0u; k < N + (glossy ? 1u : 0u); k++) {
        bool g = k == N;
        vec3 d = g ? gl : (k == 0u ? cosineSampleU(n0, bn2(p, 2u)) : cosineSample(n0, s));
        vec2 cone = vec2(pixelSpread() * P.w, g ? pixelSpread() + gSpread : DIFFUSE_SPREAD);
        GIRes c;
        bool back;
        pathSunU = k == 0u ? bn2(p, 4u) : vec2(-1);  // the first path's sun sample is blue noise too
        c.L = tracePath(x0, g ? n0 * gSide : n0, d, B, 0u, F.res.w, cone, g ? gEmit : 0.0, s, c.x, c.n, back);
        if (g) glossyL = gW * c.L * gOcc;
        else if (restir) updateGI(r, c, lum(c.L) * PI, rnd(s));  // source pdf cos/pi, target lum(L) cos
        else acc += c.L;
    }
    imageStore(specImg, p, vec4(glossyL, 1));
    Surf sf = loadSurf(p);
    vec3 kd = surfDiffuseShare(sf, max(dot(n0, -cameraRay(p)), 1e-4)) * sf.ao;  // diffuse indirect lights this share of the albedo
    uint mat = sf.mat;

    if (isBaked) {
        vec3 dyn = vec3(0);
        if (F.bake.y > 0u) {
            vec3 d = cosineSample(n0, s);
            Hit h = traceClosest(x0 + n0 * EPS, d, 1e4, vec2(pixelSpread() * P.w, DIFFUSE_SPREAD));
            if (h.hit) dyn = h.albedo * dynamicNEE(h.p, h.n, h.mat, s);
        }
        imageStore(indirectImg, p, vec4((baked + dyn) * kd + glossyL, 1));
        if (restir) storeGICur(idx, GIRes(vec3(0), vec3(0), vec3(0), 0.0, -1.0, 0.0));  // M < 0: spatial pass keeps this
        return;
    }
    if (!restir) {
        imageStore(indirectImg, p, vec4(acc / float(N) * kd + glossyL, 1));
        return;
    }

    r.M = float(N);
    float ph = giTarget(r, x0, n0);
    r.W = ph > 0.0 ? r.wSum / (r.M * ph) : 0.0;

    if ((F.settings.z & FLAG_GI_TEMPORAL) != 0u) {
        vec2 pp;
        if (prevPixel(xSeen, pp)) {
            ivec2 q = ivec2(floor(pp + 0.5));
            if (similarPrev(q, xSeen, n0, mat)) {
                GIRes h = loadGIPrev(uint(q.y) * F.res.x + uint(q.x));
                if (h.M > 0.0 && !isnan(h.W) && !isinf(h.W)) {
                    h.M = min(h.M, F.params2.y);
                    GIRes c = r;
                    c.wSum = 0.0;
                    updateGI(c, r, ph * r.W * r.M, rnd(s));
                    updateGI(c, h, giTarget(h, x0, n0) * h.W * h.M, rnd(s));
                    c.M = r.M + h.M;
                    float pc_ = giTarget(c, x0, n0);
                    c.W = pc_ > 0.0 ? c.wSum / (c.M * pc_) : 0.0;
                    r = c;
                }
            }
        }
    }
    storeGICur(idx, r);
}
