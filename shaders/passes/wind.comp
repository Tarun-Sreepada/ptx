#version 460
#extension GL_GOOGLE_include_directive : require
#include "core/common.glsl"

// One wind-map substep (pc.a = 0: A -> B, 1: B -> A). Linearised compressible flow on a 1 m grid:
//   dp/dt = -K div(u) - damping p            (converging air piles up pressure ...)
//   du/dt = -grad p + relax (target - u) + nu lap(u)   (... which pushes back out as a travelling wave)
// The target wind is the prevailing wind plus a few gust fronts that sweep through from different directions;
// where two fronts meet head-on the convergence raises a pressure ridge that radiates waves through the grass.
layout(local_size_x = 8, local_size_y = 8) in;

vec2 targetWind(vec2 x, float t) {
    vec2 base = F.wind.xy * F.wind.z;
    float wa = atan(F.wind.y, F.wind.x);
    vec2 centre = (vec2(F.windGrid.xy) + float(WIND_N) * 0.5) * WIND_CELL;
    vec2 v = base;
    for (int k = 0; k < 3; k++) {
        float period = 16.0 + 6.0 * float(k);
        float tt = t + float(k) * 7.3;
        uint e = uint(floor(tt / period)) * 3u + uint(k);
        float tl = mod(tt, period);
        float h1 = float(hashu(e * 9781u + 17u)) / 4294967295.0, h2 = float(hashu(e * 6271u + 91u)) / 4294967295.0;
        float ang = wa + (h1 - 0.5) * 2.0 * F.windSim.z;   // spread around the prevailing direction
        vec2 dir = vec2(cos(ang), sin(ang)), perp = vec2(-dir.y, dir.x);
        float speed = 7.0 + 6.0 * h2;
        float s = dot(x - centre, dir) - (speed * tl - 0.5 * speed * period);  // front crosses the window centre mid-period
        float width = 8.0 + 10.0 * h1;
        float band = exp(-s * s / (width * width)) * (0.55 + 0.45 * vnoise(vec2(dot(x, perp) / 25.0, float(e))));
        v += dir * band * F.windSim.y * F.wind.z * 1.6;
    }
    // light turbulence advected with the base wind
    vec2 q = (x - base * t * 6.0) * 0.05;
    float n1 = vnoise(q), n2 = vnoise(q + vec2(5.2, 1.3));
    v += (vec2(n1, n2) - 0.5) * 0.5 * F.wind.z;
    return v;
}

void main() {
    ivec2 t = ivec2(gl_GlobalInvocationID.xy);
    if (t.x >= WIND_N || t.y >= WIND_N) return;
    ivec2 wc = F.windGrid.xy + windTexel(t - F.windGrid.xy);
    ivec2 pwc = F.windGrid.zw + windTexel(t - F.windGrid.zw);
    float dt = F.windSim.x, time = F.windSim2.w;
    vec2 x = (vec2(wc) + 0.5) * WIND_CELL;
    vec2 tgt = targetWind(x, time);
    bool src = pc.a == 0u;
    if (wc != pwc) {  // cell just scrolled into the window: start it at the target wind
        vec4 r = vec4(tgt, 0, 0);
        if (src) imageStore(windB, t, r); else imageStore(windA, t, r);
        return;
    }
    #define LD(c) (src ? imageLoad(windA, windTexel(c)) : imageLoad(windB, windTexel(c)))
    vec4 c = LD(wc);
    ivec2 o[4] = ivec2[](ivec2(1, 0), ivec2(-1, 0), ivec2(0, 1), ivec2(0, -1));
    vec4 nb[4];
    for (int i = 0; i < 4; i++) nb[i] = windInWindow(wc + o[i]) ? LD(wc + o[i]) : c;  // closed edges
    #undef LD
    float inv2 = 0.5 / WIND_CELL;
    float div = ((nb[0].x - nb[1].x) + (nb[2].y - nb[3].y)) * inv2;
    vec2 gp = vec2(nb[0].z - nb[1].z, nb[2].z - nb[3].z) * inv2;
    vec2 lap = (nb[0].xy + nb[1].xy + nb[2].xy + nb[3].xy - 4.0 * c.xy) / (WIND_CELL * WIND_CELL);
    float plap = (nb[0].z + nb[1].z + nb[2].z + nb[3].z - 4.0 * c.z) / (WIND_CELL * WIND_CELL);
    float K = F.windSim2.x;  // wave speed^2 (m^2/s^2)
    float p = (c.z - dt * K * div + dt * 0.5 * plap) * (1.0 - F.windSim2.y * dt);
    vec2 u = c.xy + dt * (-gp * 0.25 + (tgt - c.xy) * F.windSim2.z + 1.5 * lap);
    vec4 r = vec4(clamp(u, vec2(-8), vec2(8)), clamp(p, -20.0, 20.0), 0);
    if (src) imageStore(windB, t, r); else imageStore(windA, t, r);
}
