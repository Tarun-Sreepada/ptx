#version 460
#extension GL_GOOGLE_include_directive : require
#include "core/common.glsl"
#include "materials/sss.glsl"

// ReSTIR DI spatial reuse + final shading (1 shadow ray for the chosen light, 1 for the sun). Subsurface materials
// take their diffuse light from a random walk (sss.glsl) that is lit by the same sun and light at its exit point.
layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (!inScreen(p)) return;
    uint idx = uint(p.y) * F.res.x + uint(p.x);
    vec4 P = loadRayPos(p);  // all lighting here: from where the BVH has the surface
    if (P.w < 0.0) { resPrev[idx] = vec4(0); imageStore(directImg, p, vec4(0)); return; }

    Surf sf = loadSurf(p);
    vec3 x = P.xyz, n = sf.n;
    uint mat = sf.mat;
    uint matL = matT(mat, sf.transl);
    vec3 v = -cameraRay(p);
    vec3 A = surfAlbedo(sf, max(dot(n, v), 1e-4));
    uint s = seedFor(p, 2u);
    uint NL = lightCount();
    vec3 Ld = vec3(0);
    bool sssOn = sf.sss > 0.0 && F.sssP.x > 0.5;
    float ao = (F.settings.z & FLAG_MICRO_SHADOW) != 0u ? sf.ao : 1.0;
    bool haveL = false;
    LightPoint lSel;
    float lW = 0.0;

    if (F.lightInfo.y > 0u) {
        Reservoir r = unpackRes(resCur[idx]);
        uint flags = F.settings.z;
        if ((flags & FLAG_RESTIR) != 0u && (flags & FLAG_RESTIR_SPATIAL) != 0u) {
            Reservoir c = Reservoir(r.y, 0.0, 0.0, 0.0);
            updateRes(c, r.y, targetPdf(r.y, x, n, matL) * r.W * r.M, rnd(s));
            c.M = r.M;
            for (uint k = 0u; k < F.counts.w; k++) {
                vec2 un = bn2(p, 20u + 2u * k);  // blue-noise neighbour pattern
                float a = un.x * 2.0 * PI, rad = sqrt(un.y) * F.params.w;
                ivec2 q = p + ivec2(round(vec2(cos(a), sin(a)) * rad));
                if (!inScreen(q) || q == p) continue;
                vec4 qP = loadPos(q);
                if (qP.w < 0.0) continue;
                vec4 qN = imageLoad(gNorm, q);
                if (uint(qN.w + 0.5) != mat) continue;
                if (dot(n, qN.xyz) < (mat == MAT_GRASS ? 0.5 : 0.9)) continue;
                if (abs(qP.w - P.w) > 0.1 * P.w) continue;
                Reservoir o = unpackRes(resCur[uint(q.y) * F.res.x + uint(q.x)]);
                updateRes(c, o.y, targetPdf(o.y, x, n, matL) * o.W * o.M, rnd(s));
                c.M += o.M;
            }
            float ph = targetPdf(c.y, x, n, matL);
            c.W = ph > 0.0 ? c.wSum / (c.M * ph) : 0.0;
            r = c;
        }
        resPrev[idx] = packRes(r);

        if (r.W > 0.0 && sampleLightIndex(r.y) < NL) {
            LightPoint l = lightPoint(r.y);
            vec3 wi;
            float dist;
            vec3 Li = lightIncident(l, x, wi, dist);
            vec3 fd;
            vec3 f = evalBRDFSplit(sf, v, wi, fd);
            // emitters seen in a near-mirror lobe are shared with the glossy path (glossyEmitWeight)
            if (l.area > 0.0) f = fd + (f - fd) * (1.0 - glossyEmitWeight(sf));
            if (sssOn) f -= fd;  // its diffuse light comes out of the walk
            f *= microShadow(ao, dot(n, wi));
            haveL = true; lSel = l; lW = r.W;
            float side = dot(n, wi) >= 0.0 ? 1.0 : -1.0;
            if (f.r + f.g + f.b > 0.0 && visible(x + n * (EPS * side), wi, shadowLength(l, dist)))
                Ld += Li * f * r.W;
        }
        Ld /= A;
    } else {
        resPrev[idx] = vec4(0);
    }

    Ld += sunDirectPrimary(x, sf, v, A, bn2(p, 0u), sssOn ? 0.0 : 1.0, ao);
    Ld += lightningDirect(x, sf, v, A, rnd(s));  // a flash: the channel as a line light

    if (sssOn) {  // the diffuse lobe as subsurface light: one walk, lit where it comes out
        vec3 xe, ne, thr;
        if (sssWalk(x, n, surfDiffuseColor(sf), sf.sss, uint(F.sssP.y), F.sssP.z, s, xe, ne, thr)) {
            vec3 E = vec3(0);
            if (F.sunColor.r + F.sunColor.g + F.sunColor.b > 0.0) {
                vec3 l = sampleConeU(F.sunDir.xyz, F.sunDir.w, vec2(rnd(s), rnd(s)));
                float c = dot(ne, l);
                if (c > 0.0 && visibleSun(xe + ne * EPS, l)) E += F.sunColor.rgb * cloudShadow(xe) * underwaterSun(xe) * c;
            }
            if (haveL) {
                vec3 wi;
                float dist;
                vec3 Li = lightIncident(lSel, xe, wi, dist);
                float c = dot(ne, wi);
                if (c > 0.0 && visible(xe + ne * EPS, wi, shadowLength(lSel, dist))) E += Li * c * lW;
            }
            vec3 spec = surfSpecAlbedo(sf, max(dot(n, v), 1e-4));
            Ld += thr * E / PI * (1.0 - max(spec.r, max(spec.g, spec.b))) / A;  // what the surface's Fresnel lets in
        }
    }
    imageStore(directImg, p, vec4(Ld, 1));
}
