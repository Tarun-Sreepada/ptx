#version 460
#extension GL_GOOGLE_include_directive : require
#include "core/common.glsl"

// Output resolution: DLSS-RR's denoised, upscaled HDR result -> hdrImg for post.comp.
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 43, rgba16f) uniform readonly image2D rrOut;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(rrOut)))) return;
    imageStore(hdrImg, p, vec4(max(imageLoad(rrOut, p).rgb, vec3(0)), 1));
}
