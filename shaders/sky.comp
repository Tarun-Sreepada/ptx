#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// Bakes the sky-view LUT (lat-long, horizon-weighted) for the current sun direction.
layout(local_size_x = 8, local_size_y = 8) in;

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= SKY_W || p.y >= SKY_H) return;
    float phi = ((float(p.x) + 0.5) / float(SKY_W) - 0.5) * 2.0 * PI;
    float el = skyEl((float(p.y) + 0.5) / float(SKY_H));
    vec3 d = vec3(cos(el) * sin(phi), sin(el), cos(el) * cos(phi));
    imageStore(skyLUT, p, vec4(atmosphere(d, F.sunDir.xyz), 1));
}
