#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// DLSS Ray Reconstruction inputs at render resolution: noisy HDR radiance (remodulated, with emission
// and aerial perspective, before tonemapping) plus the guide buffers RR needs.
layout(local_size_x = 8, local_size_y = 8) in;

layout(binding = 37, rg16f) uniform writeonly image2D rrMotion;       // pixels, current -> previous, unjittered
layout(binding = 38, r32f) uniform writeonly image2D rrViewZ;         // linear view depth
layout(binding = 39, rgba16f) uniform writeonly image2D rrDiffAlb;
layout(binding = 40, rgba16f) uniform writeonly image2D rrSpecAlb;
layout(binding = 41, rgba16f) uniform writeonly image2D rrNormRough;  // world normal, w = linear roughness
layout(binding = 42, rgba16f) uniform writeonly image2D rrColor;

// Pixel position (continuous, unjittered, pixel centres at +0.5) of a camera-relative direction / offset.
vec2 pixelOf(vec3 d, vec3 r, vec3 u, vec3 f, float aspect, float th) {
    float z = max(dot(d, f), 1e-6);
    float x = dot(d, r) / (z * th * aspect), y = dot(d, u) / (z * th);
    return vec2(x * 0.5 + 0.5, 0.5 - y * 0.5) * vec2(F.res.xy);
}

vec3 waterScene(ivec2 q) {
    vec3 E = imageLoad(gEmis, q).rgb;
    if (imageLoad(gDepth, q).r < 0.0) return E;
    vec3 c = imageLoad(directImg, q).rgb + imageLoad(indirectImg, q).rgb;
    float l = lum(c);
    if (l > F.params.z) c *= F.params.z / l;
    return pixelAlbedo(q) * c + E;
}
#include "water.glsl"

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (!inScreen(p)) return;
    vec4 P = loadPos(p);
    bool isSky = P.w < 0.0;
    vec3 d = cameraRay(p);
    vec3 alb = pixelAlbedo(p), E = imageLoad(gEmis, p).rgb;
    Surf sf = loadSurf(p);
    vec4 N4 = vec4(sf.n, 0.0);

    // radiance: same as composite.comp's final view, minus tonemapping
    vec3 c = imageLoad(directImg, p).rgb + imageLoad(indirectImg, p).rgb;
    float l = lum(c);
    if (l > F.params.z) c *= F.params.z / l;
    vec3 col = isSky ? E : alb * c + E;
    Water w = shadeWater(p, d, P, col);
    if (w.hit) { col = w.col; P = vec4(w.p, w.t); }
    col = underwaterView(col, isSky ? 1e4 : P.w);
    if (!isSky && F.params2.w > 0.0) {
        float h = max(P.y + VIEW_H, 0.0);
        vec3 ext = (BR * exp(-h / HR) + vec3(BME * exp(-h / HM))) * F.params2.w;
        vec3 T = exp(-ext * P.w);
        col = col * T + sky(normalize(vec3(d.x, max(d.y, 0.03), d.z))) * (1.0 - T);
    }
    vec4 fg = fogAt(p);  // volumetric fog / god rays
    col = col * fg.a + fg.rgb;
    imageStore(rrColor, p, vec4(col, 1.0));

    // material guides: the albedo split into its diffuse and specular parts (brdf.glsl surfAlbedo)
    float nv = max(dot(sf.n, -d), 1e-4);
    vec3 spec = isSky ? vec3(0) : surfSpecAlbedo(sf, nv);
    alb = isSky ? vec3(0.5) : max(alb - spec, vec3(0));
    vec2 al = surfAlpha(sf);
    float rough = sqrt(sqrt(al.x * al.y));
    if (w.hit) { alb = mix(vec3(0.05), vec3(0.8), w.foam); spec = vec3(w.fres); N4.xyz = w.n; rough = 0.08; }
    imageStore(rrDiffAlb, p, vec4(alb, 1.0));
    imageStore(rrSpecAlb, p, vec4(spec, 1.0));
    imageStore(rrNormRough, p, isSky ? vec4(0) : vec4(N4.xyz, rough));
    imageStore(rrViewZ, p, vec4(isSky ? 1e6 : dot(P.xyz - F.camPos.xyz, F.camFwd.xyz)));

    // motion: where this surface point was in the previous frame (sky: rotation only); moving objects carry their
    // own offset (G-buffer velocity)
    vec3 Pprev = P.xyz + (w.hit ? vec3(0) : imageLoad(gVel, p).xyz);
    vec3 dc = isSky ? d : P.xyz - F.camPos.xyz, dp = isSky ? d : Pprev - F.prevCamPos.xyz;
    vec2 mv = vec2(0);
    if (dot(dp, F.prevFwd.xyz) > 1e-4) {
        vec2 cur = pixelOf(dc, F.camRight.xyz, F.camUp.xyz, F.camFwd.xyz, F.camRight.w, F.camUp.w);
        vec2 prev = pixelOf(dp, F.prevRight.xyz, F.prevUp.xyz, F.prevFwd.xyz, F.prevRight.w, F.prevUp.w);
        mv = prev - cur;
    }
    imageStore(rrMotion, p, vec4(mv, 0, 0));
}
