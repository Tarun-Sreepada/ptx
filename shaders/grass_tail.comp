#version 460
#extension GL_GOOGLE_include_directive : require
#include "common.glsl"

// Writes the indirect draw for the raster pass and turns unused BLAS slots into inactive (NaN) triangles.
layout(local_size_x = 64) in;

void main() {
    uint i = gl_GlobalInvocationID.x;
    uint cap = uint(F.grassGrid.w);
    uint cnt = min(grassCount, cap);
    if (i == 0u) {
        drawIndexCount = cnt * 15u;
        drawInstanceCount = 1u;
        drawFirstIndex = 0u;
        drawVertexOffset = 0;
        drawFirstInstance = 0u;
    }
    if (i >= cnt && i < cap) {
        float nan = uintBitsToFloat(0x7fc00000u);
        for (uint k = 0u; k < 21u; k++) gv[i * 21u + k] = nan;
    }
}
